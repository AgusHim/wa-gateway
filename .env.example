# Runtime
NODE_ENV=development
APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL (host ports from docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=wa_gateway
DATABASE_URL=postgresql://postgres:password@localhost:5433/wa_gateway?schema=public

# Redis (host port from docker-compose.yml)
REDIS_URL=redis://localhost:6380

# Dashboard authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
CREDENTIAL_VAULT_KEY=replace-with-a-separate-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
REQUIRE_EMAIL_VERIFICATION=false

# Optional Google OAuth login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI provider
GOOGLE_API_KEY=replace-with-google-ai-api-key
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional Groq fallback for development
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# Default tenant bootstrap
DEFAULT_ORGANIZATION_ID=default-org
DEFAULT_WORKSPACE_ID=default-workspace
DEFAULT_CHANNEL_ID=default-channel

# WhatsApp gateway
WA_SESSION_ID=main-session
WA_GATEWAY_API_KEY=replace-with-a-long-api-key
WA_AUTH_DB_SESSION_KEY=wa-api-auth
WA_AUTH_ROOT_DIR=.wa-auth
WA_TENANT_RATE_LIMIT_PER_SEC=20
WA_BROADCAST_JITTER_MIN_MS=2000
WA_BROADCAST_JITTER_MAX_MS=8000

# Cloudflare R2 private media storage
# Create an R2 API token with Object Read & Write access to this bucket.
WA_MEDIA_STORAGE_DRIVER=r2
WA_MEDIA_R2_ACCOUNT_ID=replace-with-cloudflare-account-id
WA_MEDIA_R2_BUCKET=wa-gateway-media
WA_MEDIA_R2_PREFIX=development
WA_MEDIA_R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
WA_MEDIA_R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
WA_MEDIA_MAX_BYTES=26214400

# Local media fallback (set WA_MEDIA_STORAGE_DRIVER=local)
WA_MEDIA_STORAGE_ROOT=.wa-media

# Optional generic S3-compatible storage (set WA_MEDIA_STORAGE_DRIVER=s3)
WA_MEDIA_S3_BUCKET=
WA_MEDIA_S3_REGION=us-east-1
WA_MEDIA_S3_ENDPOINT=
WA_MEDIA_S3_PREFIX=
WA_MEDIA_S3_ACCESS_KEY_ID=
WA_MEDIA_S3_SECRET_ACCESS_KEY=
WA_MEDIA_S3_FORCE_PATH_STYLE=true

# Human handover
HANDOVER_SLA_MINUTES=30
HUMAN_HANDOVER_KEYWORDS=

# Billing
BILLING_ENFORCEMENT_ENABLED=true
BILLING_WEBHOOK_SECRET=replace-with-billing-webhook-secret

# Instagram integration (optional)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_API_VERSION=v23.0
INSTAGRAM_OAUTH_SCOPES=instagram_basic,instagram_manage_messages,instagram_manage_comments,pages_show_list,pages_read_engagement
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_APP_MODE=development
INSTAGRAM_DEV_MODE_ALLOWED_WORKSPACES=default-workspace
INSTAGRAM_OAUTH_STATE_TTL_MS=600000
INSTAGRAM_APPSECRET_PROOF_ENABLED=false
INSTAGRAM_TOKEN_REFRESH_INTERVAL_MINUTES=30
INSTAGRAM_TOKEN_REFRESH_THRESHOLD_HOURS=120

# Instagram inbound and outbound controls
INSTAGRAM_INBOUND_DEBOUNCE_MS=5000
INSTAGRAM_INBOUND_DEBOUNCE_BUFFER_TTL_MS=600000
INSTAGRAM_DM_PRIORITY_ENABLED=true
INSTAGRAM_DM_QUEUE_PRIORITY=1
INSTAGRAM_COMMENT_QUEUE_PRIORITY=8
INSTAGRAM_OUTBOUND_MAX_RETRIES=2
INSTAGRAM_OUTBOUND_REQUEST_TIMEOUT_MS=12000
INSTAGRAM_OUTBOUND_RETRY_BASE_MS=600
INSTAGRAM_OUTBOUND_RETRY_JITTER_MS=200
INSTAGRAM_OUTBOUND_CIRCUIT_FAILURE_THRESHOLD=4
INSTAGRAM_OUTBOUND_CIRCUIT_RESET_MS=30000
INSTAGRAM_OUTBOUND_CIRCUIT_SUCCESS_THRESHOLD=1
INSTAGRAM_TENANT_RATE_LIMIT_PER_SEC=15
INSTAGRAM_DM_MAX_REPLY_CHARS=1000
INSTAGRAM_COMMENT_MAX_REPLY_CHARS=300
INSTAGRAM_DM_POLICY_WINDOW_HOURS=24
INSTAGRAM_COMMENT_POLICY_WINDOW_HOURS=168

# Instagram retention
INSTAGRAM_DM_RETENTION_DAYS=365
INSTAGRAM_COMMENT_RETENTION_DAYS=180
INSTAGRAM_MEDIA_METADATA_RETENTION_DAYS=90

# Queue debounce and worker autoscaling
INBOUND_DEBOUNCE_MS=5000
INBOUND_DEBOUNCE_BUFFER_TTL_MS=600000
WORKER_AUTOSCALE_INTERVAL_MS=5000
WORKER_AUTOSCALE_TARGET_BACKLOG=20
INBOUND_WORKER_CONCURRENCY=2
INBOUND_WORKER_MIN_CONCURRENCY=1
INBOUND_WORKER_MAX_CONCURRENCY=16
OUTBOUND_WORKER_CONCURRENCY=1
OUTBOUND_WORKER_MIN_CONCURRENCY=1
OUTBOUND_WORKER_MAX_CONCURRENCY=16
INSTAGRAM_WEBHOOK_WORKER_CONCURRENCY=2
INSTAGRAM_WEBHOOK_WORKER_MIN_CONCURRENCY=1
INSTAGRAM_WEBHOOK_WORKER_MAX_CONCURRENCY=16

# Resilience
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=1

# Optional built-in tool endpoints
SMARTSCHOLAR_API_BASE_URL=https://api.smartscholar.id
SMARTSCHOLAR_API_ALLOWED_HOSTS=api.smartscholar.id
TOOL_WEBHOOK_BASE_URL=
TOOL_WEBHOOK_ALLOWED_HOSTS=
CRM_SYNC_BASE_URL=
CRM_SYNC_ALLOWED_HOSTS=
